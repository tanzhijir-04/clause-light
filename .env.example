# === LLM 配置 ===
# 至少配置一个 API Key

# DeepSeek（推荐，便宜）
LLM_DEEPSEEK_API_KEY=

# OpenAI
LLM_OPENAI_API_KEY=

# 通义千问
LLM_QWEN_API_KEY=

# === 本地 LLM（Ollama）===
OLLAMA_ENDPOINT=http://localhost:11434

# === 服务配置 ===
HOST=0.0.0.0
PORT=8080
DEBUG=false
# 开发环境可继续使用 SQLite；生产环境请改为 production 并填写 PostgreSQL。
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///data/clause_light.db
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
AUTH_PEPPER=development-only-change-me
JOB_LEASE_SECONDS=60
JOB_POLL_INTERVAL_SECONDS=1.0
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE=20971520

# === 生产环境示例（凭据仅为占位符）===
# ENVIRONMENT=production
# DATABASE_URL=postgresql+asyncpg://clauselight:change-me@localhost:5432/clauselight
# REDIS_URL=redis://localhost:6379/0
# REDIS_REQUIRED=true
# AUTH_PEPPER=change-me-before-production

# === OCR ===
OCR_USE_GPU=false
OCR_MODEL_DIR=data/models/paddleocr
OCR_AUTO_DOWNLOAD=true

# === 同步（可选）===
SYNC_ENABLED=false
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
