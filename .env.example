# === LLM 配置 ===
# 至少配置一个 API Key

# DeepSeek（推荐，便宜）
LLM_DEEPSEEK_API_KEY=

# OpenAI
LLM_OPENAI_API_KEY=

# 通义千问
LLM_QWEN_API_KEY=

# === 本地 LLM（Ollama）===
OLLAMA_ENDPOINT=http://localhost:11434

# === 服务配置 ===
HOST=0.0.0.0
PORT=8080
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///data/clause_light.db
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE=20971520

# === OCR ===
OCR_USE_GPU=false
OCR_MODEL_DIR=data/models/paddleocr
OCR_AUTO_DOWNLOAD=true

# === 同步（可选）===
SYNC_ENABLED=false
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
